/**
 * The Mirror Case bridge (D-201; ADR-0221 `0221-projects-requests-and-issues.md` decision 7):
 * sends this org's Cases to a service provider running BarnCRM Projects, through the provider's
 * request API, and reads their status back. Off until Send Cases to a service provider is on.
 *
 * Case is never named at compile time: it is resolved through describe and queried by name, so
 * Mirror installs where Case is not available (plan Section 4.2, ADR-0013). What the provider
 * answers is kept on Provider Request (`Provider_Request__c`), keyed by the Case Id, never on Case.
 *
 * Cases go by the Send Cases to a Service Provider flow action (`CaseProviderRequestAction`) or by
 * the hourly check (`CaseProviderRequestsHourly`, N-10), which sends every open Case of the chosen
 * Type not yet sent and then asks for the status of every request not yet finished, and does so
 * only when an open request or an open Case of that Type exists. The nightly step keeps the one
 * hourly job scheduled and is how an administrator sees, switches and starts it on the Nightly
 * Jobs card (ADR-0166). Callouts go to the Named Credential
 * `Barn_Request_Provider`, which the admin creates; nothing secret is stored here. All callouts
 * come before any save, as the platform requires; failures are kept on the Provider Request and
 * in the Error Log, and a failed Case is sent again by the next run.
 */
public with sharing class CaseProviderRequests implements Queueable, Database.AllowsCallouts {
	/** The step's key in the nightly run. */
	public static final String JOB_NAME = 'BarnCRM Mirror: Case requests';
	@TestVisible
	private static final String ENDPOINT = 'callout:Barn_Request_Provider/services/apexrest/barncrm/requests/v1/requests';
	/** Sends in one job, leaving room for the status calls under the callout limit. */
	@TestVisible
	private static final Integer PER_JOB = 50;
	private static final Integer PER_STATUS_CALL = 200;
	private static final String CASE_OBJECT = 'Case';
	private static final String CASE_FIELDS = 'Id, CaseNumber, Subject, Description, Priority, SuppliedName, SuppliedEmail, Contact.Name, Contact.Email';
	private static final Set<String> FINISHED = new Set<String>{
		'Resolved',
		'Closed',
		'Cancelled'
	};
	private static final String CONTEXT = 'CaseProviderRequests';
	@TestVisible
	private static Boolean unavailableForTest = false;
	/** Each callout waits at most this long. */
	private static final Integer CALLOUT_TIMEOUT_MS = 20000;
	/** Salesforce's cap on the time one transaction may spend waiting on callouts. */
	private static final Long CALLOUT_TIME_LIMIT_MS = 120000;
	/** The most accepted requests read to keep their Cases out of the sweep. */
	private static final Integer ACCEPTED_READ = 40000;
	/** Set by a test: how many more callouts this job may make. */
	@TestVisible
	private static Integer calloutsLeftForTest;

	private final List<Id> toSend;
	private final Boolean readStatus;
	private final List<String> failures = new List<String>();
	/** Time spent waiting on callouts in this job. */
	private Long calloutMillis = 0;
	/** Cases left unsent because the job ran out of callouts or callout time. */
	private final List<Id> leftOver = new List<Id>();

	/** The scheduled pass: sweep for unsent Cases, then read status. */
	public CaseProviderRequests() {
		this(null, true);
	}

	@TestVisible
	private CaseProviderRequests(List<Id> toSend, Boolean readStatus) {
		this.toSend = toSend;
		this.readStatus = readStatus;
	}

	/** Sends these Cases now (the flow action), in jobs of 50. */
	public static void send(List<Id> caseIds) {
		if (isOn() && caseIds != null && !caseIds.isEmpty()) {
			start(new CaseProviderRequests(new List<Id>(new Set<Id>(caseIds)), false));
		}
	}

	/**
	 * Queues the job through AsyncStarter. When the org is too busy, AsyncStarter logs it and the
	 * next hourly pass sends whatever is still unsent.
	 */
	private static void start(CaseProviderRequests job) {
		try {
			AsyncStarter.queue(job, CONTEXT);
		} catch (AsyncStarter.BusyException busy) {
			return;
		}
	}

	/**
	 * The step on the Nightly Jobs card, in tonight's run only while the setting is on and the
	 * org has Case. Its work is the hourly check's: it keeps the one hourly job scheduled (as the
	 * person the nightly run runs as) and checks once now. Its switch on the card turns the
	 * hourly check off too, and Run Now starts it at once. Its summary says whether the hourly
	 * job is scheduled.
	 */
	public static NightlyStep step() {
		Boolean enabled = isOn();
		return new NightlyStep(
				JOB_NAME,
				BarnHelp.text('Mirror', 'Mirror_CaseRequests_Title'),
				1,
				40,
				new CaseProviderRequestsHourly()
			)
			.withSwitch(true)
			.activeWhen(enabled)
			.withSummary(enabled ? hourlySummary() : null)
			.runnableNow();
	}

	/** Whether the hourly job is scheduled, as the Nightly Jobs card shows it. */
	private static String hourlySummary() {
		return CaseProviderRequestsHourly.isScheduled()
			? BarnHelp.text('Mirror', 'Mirror_CaseRequests_HourlyScheduled')
			: BarnHelp.text('Mirror', 'Mirror_CaseRequests_HourlyNotScheduled');
	}

	/** Send Cases to a service provider, off at install, and an org with Case. */
	public static Boolean isOn() {
		Mirror_Settings__c settings = Mirror_Settings__c.getOrgDefaults();
		return settings != null && settings.Case_Requests_Enabled__c == true && caseType() != null;
	}

	/**
	 * The hourly check, and the nightly step's work (N-10, owner decision "Hourly if cases
	 * exist"). While Send Cases to a service provider is on and the step is switched on, keeps
	 * the one hourly job and queues a pass only when there is something to check: no callout and
	 * no Error Log entry otherwise. While either is off, it removes the hourly job, so an org that
	 * stopped sending keeps no idle schedule; the next nightly run or Run Now starts it again.
	 * Safe to run any number of times.
	 */
	public static void startHourly() {
		if (!isOn() || !NightlyJobs.isSwitchedOn(JOB_NAME, true)) {
			CaseProviderRequestsHourly.stop();
			return;
		}
		CaseProviderRequestsHourly.ensure();
		if (hasOpenRequests()) {
			start(new CaseProviderRequests());
		}
	}

	/**
	 * The cheap guard before any pass: a sent request not yet Resolved, Closed or Cancelled, or an
	 * open Case of the chosen Type (which may still need sending). One row read at most, each.
	 */
	@TestVisible
	private static Boolean hasOpenRequests() {
		Boolean pending = ![
				SELECT Id
				FROM Provider_Request__c
				WHERE Request_Number__c != NULL AND Status__c NOT IN :FINISHED
				WITH SYSTEM_MODE
				LIMIT 1
			]
			.isEmpty();
		return pending ||
			!Database.queryWithBinds(
					'SELECT Id FROM ' +
						CASE_OBJECT +
						' WHERE Type = :caseType AND IsClosed = FALSE LIMIT 1',
					new Map<String, Object>{ 'caseType' => chosenType() },
					AccessLevel.USER_MODE
				)
				.isEmpty();
	}

	public void execute(QueueableContext job) {
		if (!isOn()) {
			return;
		}
		List<Id> pending = toSend ?? unsent();
		Set<String> sent = accepted(pending);
		List<Id> now = new List<Id>();
		List<Id> later = new List<Id>();
		for (Id caseId : pending) {
			if (!sent.contains(caseId)) {
				(now.size() < PER_JOB ? now : later).add(caseId);
			}
		}
		Map<String, Provider_Request__c> changed = new Map<String, Provider_Request__c>();
		for (Provider_Request__c row : sendAll(now)) {
			changed.put(row.Case_Id__c, row);
		}
		// Out of callouts or callout time: the rest waits for the next job.
		later.addAll(leftOver);
		if (readStatus) {
			for (Provider_Request__c row : readAll()) {
				changed.put(row.Case_Id__c, row);
			}
		}
		Database.upsert(
			changed.values(),
			Provider_Request__c.Case_Id__c,
			false,
			AccessLevel.SYSTEM_MODE
		);
		if (!failures.isEmpty()) {
			ErrorLogger.logMessages(failures, CONTEXT, ErrorLogger.SEVERITY_WARNING);
		}
		if (!later.isEmpty() && !Test.isRunningTest()) {
			start(new CaseProviderRequests(later, false));
		}
	}

	/**
	 * Open Cases of the chosen Type the provider has not accepted, oldest first (1,000 a pass).
	 * The accepted ones are left out in the query, not after it: an org with 1,000 accepted
	 * Cases still open would otherwise read only those, and never send a new one.
	 */
	@TestVisible
	private static List<Id> unsent() {
		Set<Id> acceptedIds = new Set<Id>();
		for (Provider_Request__c row : [
			SELECT Case_Id__c
			FROM Provider_Request__c
			WHERE Request_Number__c != NULL AND Error__c = NULL
			WITH SYSTEM_MODE
			ORDER BY Synced__c DESC NULLS LAST
			LIMIT :ACCEPTED_READ
		]) {
			try {
				acceptedIds.add(Id.valueOf(row.Case_Id__c));
			} catch (StringException notAnId) {
				continue;
			}
		}
		List<Id> ids = new List<Id>();
		for (
			SObject row : Database.queryWithBinds(
				'SELECT Id FROM ' +
					CASE_OBJECT +
					' WHERE Type = :caseType AND IsClosed = FALSE AND Id NOT IN :acceptedIds' +
					' ORDER BY CreatedDate LIMIT 1000',
				new Map<String, Object>{ 'caseType' => chosenType(), 'acceptedIds' => acceptedIds },
				AccessLevel.USER_MODE
			)
		) {
			ids.add(row.Id);
		}
		return ids;
	}

	/** Which of these Cases the provider already accepted (they have a request number). */
	private static Set<String> accepted(List<Id> caseIds) {
		Set<String> keys = new Set<String>();
		for (Id caseId : caseIds) {
			keys.add(caseId);
		}
		Set<String> done = new Set<String>();
		for (Provider_Request__c row : [
			SELECT Case_Id__c
			FROM Provider_Request__c
			WHERE Case_Id__c IN :keys AND Request_Number__c != NULL
			WITH SYSTEM_MODE
		]) {
			done.add(row.Case_Id__c);
		}
		return done;
	}

	/** Posts each Case; answers what to keep for it. */
	private List<Provider_Request__c> sendAll(List<Id> caseIds) {
		List<Provider_Request__c> rows = new List<Provider_Request__c>();
		if (caseIds.isEmpty()) {
			return rows;
		}
		for (
			SObject record : Database.queryWithBinds(
				'SELECT ' + CASE_FIELDS + ' FROM ' + CASE_OBJECT + ' WHERE Id IN :caseIds',
				new Map<String, Object>{ 'caseIds' => caseIds },
				AccessLevel.USER_MODE
			)
		) {
			String caseNumber = (String) record.get('CaseNumber');
			SObject contact = record.getSObject('Contact');
			Map<String, Object> body = new Map<String, Object>{
				'orgId' => UserInfo.getOrganizationId(),
				'reference' => caseNumber,
				'subject' => String.isBlank((String) record.get('Subject'))
					? caseNumber
					: record.get('Subject'),
				'description' => record.get('Description'),
				'priority' => record.get('Priority'),
				'requesterName' => contact?.get('Name') ?? record.get('SuppliedName'),
				'requesterEmail' => contact?.get('Email') ?? record.get('SuppliedEmail')
			};
			if (!roomForCallout()) {
				leftOver.add(record.Id);
				continue;
			}
			Provider_Request__c row = new Provider_Request__c(
				Name = caseNumber,
				Case_Id__c = record.Id,
				Synced__c = Datetime.now()
			);
			HttpResponse answer = call('POST', ENDPOINT, JSON.serialize(body), caseNumber);
			if (
				answer != null && (answer.getStatusCode() == 200 || answer.getStatusCode() == 201)
			) {
				Map<String, Object> accepted = objectIn(answer, caseNumber);
				if (accepted == null) {
					row.Error__c = BarnHelp.text('Mirror', 'Mirror_CaseRequests_ErrorUnreadable')
						.abbreviate(255);
				} else {
					keep(row, accepted);
					row.Error__c = null;
				}
			} else {
				row.Error__c = refusal(answer);
			}
			rows.add(row);
		}
		return rows;
	}

	/**
	 * The JSON object a response holds, or null, with the reason kept for the Error Log, when
	 * it holds something else: one Case's unreadable answer never costs the others their saves.
	 */
	private Map<String, Object> objectIn(HttpResponse answer, String what) {
		try {
			Object parsed = JSON.deserializeUntyped(answer.getBody());
			if (parsed instanceof Map<String, Object>) {
				return (Map<String, Object>) parsed;
			}
			failures.add(
				BarnHelp.text(
					'Mirror',
					'Mirror_CaseRequests_Unreadable',
					new List<Object>{ what, answer.getStatusCode() }
				)
			);
		} catch (JSONException unreadable) {
			failures.add(
				BarnHelp.text(
					'Mirror',
					'Mirror_CaseRequests_Unreadable',
					new List<Object>{ what, unreadable.getMessage() }
				)
			);
		}
		return null;
	}

	/**
	 * Whether this job may make another callout: under Salesforce's callout count, and with a
	 * full timeout's wait still inside its cap on callout time. What is left goes to the next job.
	 */
	private Boolean roomForCallout() {
		if (calloutsLeftForTest != null) {
			return calloutsLeftForTest > 0;
		}
		return Limits.getCallouts() < Limits.getLimitCallouts() &&
			calloutMillis + CALLOUT_TIMEOUT_MS <= CALLOUT_TIME_LIMIT_MS;
	}

	/** Asks for the status of every sent request not yet finished, 200 a call. */
	private List<Provider_Request__c> readAll() {
		List<Provider_Request__c> rows = new List<Provider_Request__c>();
		Map<String, Provider_Request__c> byNumber = new Map<String, Provider_Request__c>();
		for (Provider_Request__c row : [
			SELECT Id, Name, Case_Id__c
			FROM Provider_Request__c
			WHERE Request_Number__c != NULL AND Status__c NOT IN :FINISHED
			WITH SYSTEM_MODE
			ORDER BY Synced__c ASC NULLS FIRST
			LIMIT 2000
		]) {
			byNumber.put(row.Name, row);
		}
		List<String> batch = new List<String>();
		for (String caseNumber : byNumber.keySet()) {
			batch.add(caseNumber);
			if (batch.size() == PER_STATUS_CALL) {
				if (!roomForCallout()) {
					// The rest are read by the next run, oldest synced first.
					return rows;
				}
				rows.addAll(read(batch, byNumber));
				batch = new List<String>();
			}
		}
		if (!batch.isEmpty() && roomForCallout()) {
			rows.addAll(read(batch, byNumber));
		}
		return rows;
	}

	private List<Provider_Request__c> read(
		List<String> refs,
		Map<String, Provider_Request__c> byNumber
	) {
		List<Provider_Request__c> rows = new List<Provider_Request__c>();
		String query =
			'?orgId=' +
			EncodingUtil.urlEncode(UserInfo.getOrganizationId(), 'UTF-8') +
			'&refs=' +
			EncodingUtil.urlEncode(String.join(refs, ','), 'UTF-8');
		HttpResponse answer = call(
			'GET',
			ENDPOINT + query,
			null,
			BarnHelp.text('Mirror', 'Mirror_CaseRequests_StatusCall')
		);
		if (answer == null || answer.getStatusCode() != 200) {
			return rows;
		}
		String what = BarnHelp.text('Mirror', 'Mirror_CaseRequests_StatusCall');
		Map<String, Object> body = objectIn(answer, what);
		if (body == null) {
			return rows;
		}
		if (!(body.get('requests') instanceof List<Object>)) {
			failures.add(
				BarnHelp.text(
					'Mirror',
					'Mirror_CaseRequests_Unreadable',
					new List<Object>{ what, 'requests' }
				)
			);
			return rows;
		}
		for (Object item : (List<Object>) body.get('requests')) {
			if (!(item instanceof Map<String, Object>)) {
				continue;
			}
			Map<String, Object> request = (Map<String, Object>) item;
			Provider_Request__c known = byNumber.get(String.valueOf(request.get('reference')));
			if (known != null) {
				Provider_Request__c row = new Provider_Request__c(
					Case_Id__c = known.Case_Id__c,
					Synced__c = Datetime.now()
				);
				rows.add(keep(row, request));
			}
		}
		return rows;
	}

	/** The provider's number, status and resolution onto the row. */
	private static Provider_Request__c keep(Provider_Request__c row, Map<String, Object> answer) {
		row.Request_Number__c = text(answer.get('number'), 30);
		row.Status__c = text(answer.get('status'), 40);
		row.Resolution__c = text(answer.get('resolution'), 32768);
		return row;
	}

	private static String text(Object value, Integer max) {
		return value == null ? null : String.valueOf(value).abbreviate(max);
	}

	/** One callout; null when it could not be made, with the reason kept for the Error Log. */
	private HttpResponse call(String method, String endpoint, String body, String what) {
		HttpRequest request = new HttpRequest();
		request.setMethod(method);
		request.setEndpoint(endpoint);
		request.setHeader('Content-Type', 'application/json');
		request.setTimeout(CALLOUT_TIMEOUT_MS);
		if (body != null) {
			request.setBody(body);
		}
		if (calloutsLeftForTest != null) {
			calloutsLeftForTest--;
		}
		Long startedAt = System.currentTimeMillis();
		try {
			HttpResponse answer = new Http().send(request);
			calloutMillis += System.currentTimeMillis() - startedAt;
			if (answer.getStatusCode() >= 300) {
				failures.add(
					BarnHelp.text(
						'Mirror',
						'Mirror_CaseRequests_Refused',
						new List<Object>{ what, answer.getStatusCode() }
					)
				);
			}
			return answer;
		} catch (Exception failed) {
			calloutMillis += System.currentTimeMillis() - startedAt;
			failures.add(
				BarnHelp.text(
					'Mirror',
					'Mirror_CaseRequests_NotReached',
					new List<Object>{ what, failed.getMessage() }
				)
			);
			return null;
		}
	}

	/** The short reason a send failed, kept on the Provider Request. */
	private static String refusal(HttpResponse answer) {
		if (answer == null) {
			return BarnHelp.text('Mirror', 'Mirror_CaseRequests_ErrorNotReached');
		}
		return BarnHelp.text(
				'Mirror',
				'Mirror_CaseRequests_ErrorRefused',
				new List<Object>{ answer.getStatusCode() }
			)
			.abbreviate(255);
	}

	/** The Case Type the hourly check sends, default Service Provider. */
	private static String chosenType() {
		Mirror_Settings__c settings = Mirror_Settings__c.getOrgDefaults();
		return String.isBlank(settings?.Case_Requests_Type__c)
			? 'Service Provider'
			: settings.Case_Requests_Type__c;
	}

	@TestVisible
	private static Schema.SObjectType caseType() {
		return unavailableForTest ? null : NamespaceUtil.globalDescribe().get(CASE_OBJECT);
	}
}
