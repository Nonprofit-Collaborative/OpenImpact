<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
  <compactLayoutAssignment>Accounting_Export_Run_Compact</compactLayoutAssignment>
  <deploymentStatus>Deployed</deploymentStatus>
  <description>
    One occasion on which somebody produced the accounting export: the range of gift dates asked
    for, what narrowed it, and the totals that came back. It is how a bookkeeper tells whether a
    period has already been sent to the accounting package (canonical model Section 29A,
    ADR-0032).
  </description>
  <enableActivities>false</enableActivities>
  <enableBulkApi>true</enableBulkApi>
  <enableFeeds>false</enableFeeds>
  <enableHistory>false</enableHistory>
  <enableReports>true</enableReports>
  <enableSearch>true</enableSearch>
  <enableSharing>true</enableSharing>
  <enableStreamingApi>true</enableStreamingApi>
  <label>Accounting Export Run</label>
  <nameField>
    <displayFormat>AE-{000000}</displayFormat>
    <label>Export Number</label>
    <trackHistory>false</trackHistory>
    <type>AutoNumber</type>
  </nameField>
  <pluralLabel>Accounting Export Runs</pluralLabel>
  <sharingModel>ReadWrite</sharingModel>
  <visibility>Public</visibility>
</CustomObject>
