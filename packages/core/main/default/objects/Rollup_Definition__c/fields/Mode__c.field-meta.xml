<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mode__c</fullName>
    <description>When the number is recalculated: in the transaction that changed a record, in the nightly batch, or both.</description>
    <externalId>false</externalId>
    <inlineHelpText>Real time updates the number as records are saved. Scheduled updates it in the nightly run. Both does the first and reconciles with the second.</inlineHelpText>
    <label>Mode</label>
    <required>false</required>
    <trackHistory>true</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Real-time</fullName>
                <default>false</default>
                <label>Real time</label>
            </value>
            <value>
                <fullName>Scheduled</fullName>
                <default>false</default>
                <label>Scheduled</label>
            </value>
            <value>
                <fullName>Both</fullName>
                <default>true</default>
                <label>Both</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
