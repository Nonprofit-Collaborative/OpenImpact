<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Seasonal_Day_In_Range</fullName>
  <active>true</active>
  <description>A seasonal day is a day of the month.</description>
  <errorConditionFormula>OR(AND(NOT(ISBLANK(Seasonal_Start_Day__c)), OR(Seasonal_Start_Day__c &lt; 1, Seasonal_Start_Day__c &gt; 31)), AND(NOT(ISBLANK(Seasonal_End_Day__c)), OR(Seasonal_End_Day__c &lt; 1, Seasonal_End_Day__c &gt; 31)))</errorConditionFormula>
  <errorDisplayField>Seasonal_Start_Day__c</errorDisplayField>
  <errorMessage>A seasonal day is a number from 1 to 31.</errorMessage>
</ValidationRule>
