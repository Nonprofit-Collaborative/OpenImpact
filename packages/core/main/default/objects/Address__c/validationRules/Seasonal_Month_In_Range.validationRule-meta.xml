<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Seasonal_Month_In_Range</fullName>
  <active>true</active>
  <description>A seasonal month is a calendar month number.</description>
  <errorConditionFormula>OR(AND(NOT(ISBLANK(Seasonal_Start_Month__c)), OR(Seasonal_Start_Month__c &lt; 1, Seasonal_Start_Month__c &gt; 12)), AND(NOT(ISBLANK(Seasonal_End_Month__c)), OR(Seasonal_End_Month__c &lt; 1, Seasonal_End_Month__c &gt; 12)))</errorConditionFormula>
  <errorDisplayField>Seasonal_Start_Month__c</errorDisplayField>
  <errorMessage>A seasonal month is a number from 1 (January) to 12 (December).</errorMessage>
</ValidationRule>
