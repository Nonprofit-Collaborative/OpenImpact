<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
  <label>Formal greeting: title, first name, surname</label>
  <protected>true</protected>
  <values>
    <field>Default_Enabled__c</field>
    <value xsi:type="xsd:boolean">true</value>
  </values>
  <values>
    <field>Description__c</field>
    <value xsi:type="xsd:string">
      Produces Mr. and Mrs. John Smith when two people share a surname, and Mr. John Smith and
      Ms. Jane Jones when they do not.
    </value>
  </values>
  <values>
    <field>Pattern_Type__c</field>
    <value xsi:type="xsd:string">Formal Greeting</value>
  </values>
  <values>
    <field>Pattern__c</field>
    <value xsi:type="xsd:string">{Salutation} {FirstName} {LastName}</value>
  </values>
</CustomMetadata>
