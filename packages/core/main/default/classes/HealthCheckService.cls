	 */
	public static final String GROUP_ADMIN = 'BarnCRM_Admin_Group';
	public static final String PERMISSION_SET_ADMIN = 'BarnCRM_Admin';
	public static final Set<String> BARNCRM_GROUPS = new Set<String>{
		GROUP_ADMIN,
		'Fundraising_Staff',
		'Program_Staff',
		'Read_Only'
