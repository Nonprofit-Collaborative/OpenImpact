			Test.startTest();
			Contact john = HouseholdTestDataFactory.newContact('Mr.', 'John', 'Smith');
			john.AccountId = employer.Id;
			insert john;
			Test.stopTest();

			Assert.areEqual(
				0,
				[SELECT COUNT() FROM Household_Member__c WHERE Household__c = :employer.Id],
