			Test.startTest();
			System.runAs(maria) {
				message = refusalFor(new List<Account>{ household }, null);
			}
			Test.stopTest();

			Assert.areEqual(
				BarnHelp.text('Core', 'Core_Households_ErrorCreateNoAccess'),
				message,
				'Refused'
			);
			Assert.areEqual(0, householdsNamed('Field Household'), 'Nothing was created');
		}
	}

	@IsTest
	static void aTouchedHouseholdThePersonCannotEditIsRefusedAndNothingIsCreated() {
		System.runAs(TestUsers.admin()) {
			String orgDefault = [SELECT DefaultAccountAccess FROM Organization LIMIT 1]
			.DefaultAccountAccess;
			if (orgDefault == 'Edit' || orgDefault == 'ReadEditTransfer') {
				// Everyone edits every account here, so no household is one staff cannot edit.
				Assert.isNotNull(orgDefault, 'Only a public read and write org skips this');
				return;
			}
			Account theirs = HouseholdTestDataFactory.newHousehold('Not Theirs');
			Database.insert(theirs, AccessLevel.SYSTEM_MODE);
			User maria = staff('Hwtouch');
			String message;

			Test.startTest();
			System.runAs(maria) {
				message = refusalFor(
					new List<Account>{ HouseholdTestDataFactory.newHousehold('Split Household') },
					new Set<Id>{ theirs.Id }
				);
			}
			Test.stopTest();

			Assert.areEqual(
				BarnHelp.text('Core', 'Core_Households_ErrorCreateNoHouseholdAccess'),
				message,
				'Refused'
			);
			Assert.areEqual(0, householdsNamed('Split Household'), 'Nothing was created');
		}
	}

	@IsTest
	static void anAccountOfAnotherRecordTypeIsRefused() {
		System.runAs(TestUsers.admin()) {
			Id other;
			for (Schema.RecordTypeInfo info : Schema.SObjectType.Account.getRecordTypeInfos()) {
				if (
					!info.isMaster() &&
					info.getRecordTypeId() != HouseholdService.householdRecordTypeId()
				) {
					other = info.getRecordTypeId();
					break;
				}
			}
			if (other == null) {
				Assert.isNotNull(HouseholdService.householdRecordTypeId(), 'Only Household here');
				return;
			}
			User maria = staff('Hwother');
			String message;

			Test.startTest();
			System.runAs(maria) {
				message = refusalFor(
					new List<Account>{
						TestDataFactory.organization(
							new Account(Name = 'Other Type', RecordTypeId = other)
						)
					},
					null
				);
			}
			Test.stopTest();

			Assert.areEqual(
				BarnHelp.text('Core', 'Core_Households_ErrorNotAHousehold'),
				message,
				'Refused'
			);
			Assert.areEqual(0, householdsNamed('Other Type'), 'Nothing was created');
		}
	}

	/** 251 households, then one more whose change touches all 251 (checked 200 at a time). */
	@IsTest
	static void twoHundredFiftyOneHouseholdsAreCreatedAndCheckedInBulk() {
		System.runAs(TestUsers.admin()) {
			User maria = staff('Hwbulk');
			List<Account> created;
			List<Database.SaveResult> last;

			Test.startTest();
			System.runAs(maria) {
				created = HouseholdTestDataFactory.insertHouseholds('Bulk Household', 251);
				Set<Id> touched = new Map<Id, Account>(created).keySet();
				last = HouseholdWriter.createHouseholdsForUser(
					new List<Account>{ HouseholdTestDataFactory.newHousehold('Bulk Touching') },
					touched
				);
			}
			Test.stopTest();

			Assert.isTrue(last[0].isSuccess(), HouseholdWriter.failureReason(last[0]));
			Id householdType = HouseholdService.householdRecordTypeId();
			Assert.areEqual(
				252,
				[
					SELECT COUNT()
					FROM Account
					WHERE Name LIKE 'Bulk %' AND RecordTypeId = :householdType
					WITH SYSTEM_MODE
				],
				'Every household was created'
			);
		}
	}

	/**
	 * ADR-0141, D-134 adjustment A: no role set gives the Household record type, yet a staff
	 * member adding a person still gets them a household, may edit it, and may not create one
	 * past BarnCRM with a user mode insert.
	 */
	@IsTest
	static void aStaffMemberWithoutTheHouseholdRecordTypeStillGetsAHouseholdForANewPerson() {
		System.runAs(TestUsers.admin()) {
			HouseholdTestDataFactory.settings(HouseholdTestDataFactory.MODE_CONTACT);
			User maria = staff('Hwnort');
			Contact ana = HouseholdTestDataFactory.newContact('Ms.', 'Ana', 'Nortega');
			Boolean recordTypeOffered;
			Boolean editSaved;
			Boolean directInsertRefused = false;

			Test.startTest();
			System.runAs(maria) {
				recordTypeOffered = Schema.SObjectType.Account.getRecordTypeInfosById()
					.get(HouseholdService.householdRecordTypeId())
					.isAvailable();
				Database.insert(ana, AccessLevel.USER_MODE);
				Id householdId = [
					SELECT AccountId
					FROM Contact
					WHERE Id = :ana.Id
					WITH USER_MODE
				]
				.AccountId;
				editSaved = Database.update(
						new Account(
							Id = householdId,
							Name = 'The Nortega Home',
							Custom_Name__c = true
						),
						AccessLevel.USER_MODE
					)
					.isSuccess();
				try {
					Database.insert(
						HouseholdTestDataFactory.newHousehold('Past BarnCRM'),
						AccessLevel.USER_MODE
					);
				} catch (DmlException refused) {
					directInsertRefused = true;
				}
			}
			Test.stopTest();

			Assert.isFalse(recordTypeOffered, 'BarnCRM Staff does not give Household');
			Contact saved = [
				SELECT Account.RecordTypeId, Account.Name
				FROM Contact
				WHERE Id = :ana.Id
				WITH SYSTEM_MODE
			];
			Assert.areEqual(
				HouseholdService.householdRecordTypeId(),
				saved.Account.RecordTypeId,
				'Ana was given a household'
			);
			Assert.isTrue(editSaved, 'Maria may edit the household');
			Assert.areEqual('The Nortega Home', saved.Account.Name, 'The edit was saved');
			Assert.isTrue(directInsertRefused, 'A user mode household insert is refused');
		}
	}
}
