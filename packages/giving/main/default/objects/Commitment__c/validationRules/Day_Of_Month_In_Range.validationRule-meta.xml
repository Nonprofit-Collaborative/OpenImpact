<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Day_Of_Month_In_Range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
        NOT(ISBLANK(Day_of_Month__c)),
        OR(Day_of_Month__c &lt; 1, Day_of_Month__c &gt; 31)
    )</errorConditionFormula>
    <errorDisplayField>Day_of_Month__c</errorDisplayField>
    <errorMessage>Day of month is a day between 1 and 31, or empty to use the day of the start date.</errorMessage>
</ValidationRule>
