<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>One_Donor_Not_None</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
        ISBLANK(Donor_Contact__c),
        ISBLANK(Donor_Account__c)
    )</errorConditionFormula>
    <errorMessage>Choose a donor for this commitment, either a person or an account.</errorMessage>
</ValidationRule>
