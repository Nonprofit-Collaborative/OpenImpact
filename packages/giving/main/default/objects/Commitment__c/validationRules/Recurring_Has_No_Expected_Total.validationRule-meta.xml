<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Recurring_Has_No_Expected_Total</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
        ISPICKVAL(Type__c, &quot;Recurring&quot;),
        NOT(ISBLANK(Expected_Total__c))
    )</errorConditionFormula>
    <errorMessage>A recurring commitment has no expected total. Choose Pledge if the donor promised a fixed amount.</errorMessage>
</ValidationRule>
