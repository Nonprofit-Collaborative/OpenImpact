<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
  <compactLayoutAssignment>Donor_Level_Compact</compactLayoutAssignment>
  <deploymentStatus>Deployed</deploymentStatus>
  <description>
    One rung of the organization's giving ladder: what it calls a group of donors, and the amount
    at which a donor reaches it. A level labels a giving total that has already been calculated
    and never adds up gifts of its own (canonical model R-DL1, ADR-0028).
  </description>
  <enableActivities>false</enableActivities>
  <enableBulkApi>true</enableBulkApi>
  <enableFeeds>false</enableFeeds>
  <enableHistory>false</enableHistory>
  <enableReports>true</enableReports>
  <enableSearch>true</enableSearch>
  <enableSharing>true</enableSharing>
  <enableStreamingApi>true</enableStreamingApi>
  <label>Donor Level</label>
  <nameField>
    <label>Level Name</label>
    <trackHistory>false</trackHistory>
    <type>Text</type>
  </nameField>
  <pluralLabel>Donor Levels</pluralLabel>
  <sharingModel>ReadWrite</sharingModel>
  <visibility>Public</visibility>
</CustomObject>
