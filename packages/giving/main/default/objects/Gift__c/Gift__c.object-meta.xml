<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
  <compactLayoutAssignment>Gift_Compact</compactLayoutAssignment>
  <deploymentStatus>Deployed</deploymentStatus>
  <description>
    One received transaction: money, stock or goods that arrived, from one donor, on one date. A
    refund or a write-off is a separate gift with a negative amount, linked to the original.
  </description>
  <enableActivities>true</enableActivities>
  <enableBulkApi>true</enableBulkApi>
  <enableFeeds>false</enableFeeds>
  <enableHistory>false</enableHistory>
  <enableReports>true</enableReports>
  <enableSearch>true</enableSearch>
  <enableSharing>true</enableSharing>
  <enableStreamingApi>true</enableStreamingApi>
  <label>Gift</label>
  <nameField>
    <displayFormat>G-{000000}</displayFormat>
    <label>Gift Number</label>
    <trackHistory>false</trackHistory>
    <type>AutoNumber</type>
  </nameField>
  <pluralLabel>Gifts</pluralLabel>
  <sharingModel>Private</sharingModel>
  <visibility>Public</visibility>
</CustomObject>
