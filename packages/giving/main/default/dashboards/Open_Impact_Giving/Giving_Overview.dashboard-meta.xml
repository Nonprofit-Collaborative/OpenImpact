<?xml version="1.0" encoding="UTF-8" ?>
<Dashboard xmlns="http://soap.sforce.com/2006/04/metadata">
  <backgroundEndColor>#FFFFFF</backgroundEndColor>
  <backgroundFadeDirection>Diagonal</backgroundFadeDirection>
  <backgroundStartColor>#FFFFFF</backgroundStartColor>
  <chartTheme>light</chartTheme>
  <dashboardType>LoggedInUser</dashboardType>
  <description>
    How much came in this month, which funds and appeals it came through, and who gave the most this
    year.
  </description>
  <leftSection>
    <columnSize>Medium</columnSize>
    <components>
      <componentType>Metric</componentType>
      <displayUnits>Auto</displayUnits>
      <drillEnabled>true</drillEnabled>
      <footer>Gifts received since the first of this month</footer>
      <header>Gifts this month</header>
      <report>Open_Impact_Giving/Gifts_This_Month_by_Day</report>
    </components>
    <components>
      <componentType>Column</componentType>
      <drillEnabled>true</drillEnabled>
      <header>This month, day by day</header>
      <legendPosition>Bottom</legendPosition>
      <report>Open_Impact_Giving/Gifts_This_Month_by_Day</report>
    </components>
  </leftSection>
  <middleSection>
    <columnSize>Medium</columnSize>
    <components>
      <componentType>Column</componentType>
      <drillEnabled>true</drillEnabled>
      <footer>The last twelve months, this month at the right</footer>
      <header>Giving by month</header>
      <legendPosition>Bottom</legendPosition>
      <report>Open_Impact_Giving/Giving_by_Month</report>
    </components>
    <components>
      <componentType>Bar</componentType>
      <drillEnabled>true</drillEnabled>
      <header>Giving by fund, this year</header>
      <legendPosition>Bottom</legendPosition>
      <report>Open_Impact_Giving/Giving_by_Fund_This_Year</report>
    </components>
  </middleSection>
  <rightSection>
    <columnSize>Medium</columnSize>
    <components>
      <componentType>Bar</componentType>
      <drillEnabled>true</drillEnabled>
      <header>Giving by appeal, this year</header>
      <legendPosition>Bottom</legendPosition>
      <report>Open_Impact_Giving/Giving_by_Appeal_This_Year</report>
    </components>
    <components>
      <componentType>Table</componentType>
      <drillEnabled>true</drillEnabled>
      <footer>Organizations give without a household, so they are not on this list</footer>
      <header>Top donors, this year</header>
      <maxValuesDisplayed>10</maxValuesDisplayed>
      <report>Open_Impact_Giving/Top_Donors_This_Year</report>
    </components>
  </rightSection>
  <textColor>#000000</textColor>
  <title>Giving Overview</title>
  <titleColor>#000000</titleColor>
  <titleSize>12</titleSize>
</Dashboard>
