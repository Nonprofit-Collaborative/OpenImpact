  <description>
    SYBUNT: gave in some earlier fiscal year, has not given this fiscal year. Some year reaches
    all the way back, because the test is that the donor's most recent gift of more than zero
    falls before this fiscal year began. Grouped by the fiscal year of that last gift, so the
    donors who lapsed last year and the donors who lapsed six years ago are separate lines.
  </description>
  <filter>
    <criteriaItems>
      <column>Account.Last_Gift_Date__c</column>
      <operator>lessThan</operator>
      <value>THIS_FISCAL_YEAR</value>
    </criteriaItems>
  </filter>
  <format>Summary</format>
  <groupingsDown>
    <dateGranularity>FiscalYear</dateGranularity>
    <field>Account.Last_Gift_Date__c</field>
    <sortOrder>Desc</sortOrder>
  </groupingsDown>
  <name>SYBUNT Donors</name>
  <reportType>Donors_with_Giving</reportType>
  <scope>organization</scope>
  <showDetails>true</showDetails>
</Report>
