<?xml version="1.0" encoding="UTF-8" ?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
  <buckets>
    <bucketType>number</bucketType>
    <developerName>BucketField_Second_Gift</developerName>
    <masterLabel>Gave a second gift</masterLabel>
    <nullTreatment>z</nullTreatment>
    <sourceColumnName>Account.Gift_Count__c</sourceColumnName>
    <values>
      <sourceValues>
        <to>1.5</to>
      </sourceValues>
      <value>First gift only</value>
    </values>
    <values>
      <sourceValues>
        <from>1.5</from>
      </sourceValues>
      <value>Gave again</value>
    </values>
  </buckets>
  <columns>
    <field>Account.Name</field>
  </columns>
  <columns>
    <field>Account.First_Gift_Date__c</field>
  </columns>
  <columns>
    <field>Account.Gift_Count__c</field>
  </columns>
  <columns>
    <field>Account.Last_Gift_Date__c</field>
  </columns>
  <columns>
    <aggregateTypes>Sum</aggregateTypes>
    <field>Account.Total_Giving__c</field>
  </columns>
  <columns>
    <field>Account.Rollups_Last_Calculated__c</field>
  </columns>
  <description>
    Of the donors whose first gift fell in one of the two completed fiscal years, how many have
    given a second gift since. The cohort is the fiscal year of the first gift; the second
    grouping is whether the donor's gift count has ever passed one. The window is from the first
    gift until today, which is between twelve and twenty four months for the newer cohort and
    longer for the older one, so read the two cohorts as two numbers rather than one trend.
  </description>
  <filter>
    <criteriaItems>
      <column>Account.First_Gift_Date__c</column>
      <operator>equals</operator>
      <value>LAST_N_FISCAL_YEARS:2</value>
    </criteriaItems>
  </filter>
  <format>Summary</format>
  <groupingsDown>
    <dateGranularity>FiscalYear</dateGranularity>
    <field>Account.First_Gift_Date__c</field>
    <sortOrder>Desc</sortOrder>
  </groupingsDown>
  <groupingsDown>
    <field>BucketField_Second_Gift</field>
    <sortOrder>Asc</sortOrder>
  </groupingsDown>
  <name>First to Second Gift Conversion</name>
  <reportType>Donors_with_Giving</reportType>
  <scope>organization</scope>
  <showDetails>false</showDetails>
</Report>
