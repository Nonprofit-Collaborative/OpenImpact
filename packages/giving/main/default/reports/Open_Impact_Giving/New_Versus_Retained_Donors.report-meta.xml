  </columns>
  <description>
    Everyone who has given this fiscal year, split three ways. The first grouping is the fiscal
    year of their first gift: the current fiscal year means a new donor. The second grouping
    says whether they also gave last fiscal year, counted as gifts rather than added as money:
    an earlier first gift plus a gift last year is a retained donor, and an earlier first gift
    with nothing last year is a reactivated donor. Record count is donors, not gifts.
  </description>
  <filter>
    <criteriaItems>
      <column>Account.Last_Gift_Date__c</column>
      <operator>equals</operator>
      <value>THIS_FISCAL_YEAR</value>
    </criteriaItems>
  </filter>
  <format>Summary</format>
  <groupingsDown>
    <dateGranularity>FiscalYear</dateGranularity>
    <field>Account.First_Gift_Date__c</field>
    <sortOrder>Desc</sortOrder>
  </groupingsDown>
  <groupingsDown>
    <field>BucketField_Gave_Last_Year</field>
    <sortOrder>Asc</sortOrder>
  </groupingsDown>
  <name>New Versus Retained Donors</name>
  <reportType>Donors_with_Giving</reportType>
  <scope>organization</scope>
  <showDetails>false</showDetails>
</Report>
