<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <label>Nonprofit Cloud: gift transactions</label>
  <protected>true</protected>
  <values>
    <field>Template_Key__c</field>
    <value xsi:type="xsd:string">npc_gift_transactions</value>
  </values>
  <values>
    <field>Description__c</field>
    <value
      xsi:type="xsd:string"
    >Gifts from people, exported from Nonprofit Cloud with their fund designations: one line for each designation of each paid gift. The donor is found by email. Use the export on the "Migrating from Nonprofit Cloud" page of the admin guide. A gift split across several designations is rejected by the dry run so that you can put its parts on one line; gifts with no designation use the undesignated gifts mapping.</value>
  </values>
  <values>
    <field>Column_Mapping_JSON__c</field>
    <value
      xsi:type="xsd:string"
    >{"version": 1, "columns": [{"source": "GiftTransactionId", "target": "Gift.External_Id__c"}, {"source": "GiftTransaction.OriginalAmount", "target": "Gift.Amount__c"}, {"source": "GiftTransaction.TransactionDate", "target": "Gift.Gift_Date__c"}, {"source": "GiftTransaction.PaymentMethod", "target": "Gift.Type__c"}, {"source": "GiftTransaction.PaymentIdentifier", "target": "Gift.Payment_Reference__c"}, {"source": "GiftTransaction.Campaign.Name", "target": "Gift.Appeal"}, {"source": "GiftTransaction.Donor.FirstName", "target": "Contact1.FirstName"}, {"source": "GiftTransaction.Donor.LastName", "target": "Contact1.LastName"}, {"source": "GiftTransaction.Donor.PersonEmail", "target": "Contact1.Email"}, {"source": "GiftTransaction.Donor.PersonMailingPostalCode", "target": "Contact1.MailingPostalCode"}, {"source": "GiftDesignation.Name", "target": "Allocation.Fund1"}, {"source": "Amount", "target": "Allocation.Amount1"}, {"source": "Fund 2", "target": "Allocation.Fund2"}, {"source": "Amount 2", "target": "Allocation.Amount2"}, {"source": "Fund 3", "target": "Allocation.Fund3"}, {"source": "Amount 3", "target": "Allocation.Amount3"}, {"source": "Fund 4", "target": "Allocation.Fund4"}, {"source": "Amount 4", "target": "Allocation.Amount4"}, {"source": "Fund 5", "target": "Allocation.Fund5"}, {"source": "Amount 5", "target": "Allocation.Amount5"}]}</value>
  </values>
  <values>
    <field>Default_Values_JSON__c</field>
