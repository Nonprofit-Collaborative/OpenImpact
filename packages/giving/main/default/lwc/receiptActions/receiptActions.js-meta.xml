  <masterLabel>Receipts</masterLabel>
  <targets>
    <target>lightning__RecordPage</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightning__RecordPage">
      <objects>
        <object>Gift__c</object>
      </objects>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>
