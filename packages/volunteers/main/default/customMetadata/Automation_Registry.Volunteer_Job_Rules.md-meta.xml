<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <label>Volunteer job: a used job is deactivated, not deleted</label>
    <protected>true</protected>
    <values>
        <field>Object_Name__c</field>
        <value xsi:type="xsd:string">Volunteer_Job__c</value>
    </values>
    <values>
        <field>Handler_Class__c</field>
        <value xsi:type="xsd:string">VolunteerJobTriggerHandler</value>
    </values>
    <values>
        <field>Execution_Order__c</field>
        <value xsi:type="xsd:double">10</value>
    </values>
    <values>
        <field>Enabled_By_Default__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Description__c</field>
        <value xsi:type="xsd:string">Refuses the deletion of a job that has shifts or hours against it, and says to untick Active instead (R-VJ1). Switching it off lets a job be deleted, and the platform then takes its shifts and sign-ups with it.</value>
    </values>
</CustomMetadata>
